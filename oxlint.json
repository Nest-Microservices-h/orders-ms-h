{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "env": {
    "node": true
  },

  "options": {
    "typeAware": true
  },

  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "warn",
    "typescript/no-unsafe-argument": "warn"
  },

  "overrides": [
    {
      "files": [
        "**/*.spec.ts",
        "**/*.test.ts"
      ],
      "env": {
        "jest": true
      },
      "plugins": [
        "jest"
      ]
    }
  ]
}
